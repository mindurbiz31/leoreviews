---
interface Props {
  tableData: string[][];
}

const { tableData = [] } = Astro.props as Props;

const headers = tableData[0] ?? [];
const rows = tableData.slice(1);
---

{
  tableData.length > 0 && headers.length > 0 ? (
    <div class="my-6 w-full max-w-full overflow-hidden rounded-xl border border-gray-200">
      <div class="w-full overflow-x-auto overscroll-x-contain">
        <table class="w-full min-w-max border-collapse text-left text-sm sm:text-base">
          <thead class="bg-gray-100">
            <tr>
              {headers.map((header) => (
                <th
                  scope="col"
                  class="min-w-40 max-w-sm border-b border-gray-200
                       px-4 py-3 font-semibold text-gray-900
                       sm:px-5 sm:py-4"
                >
                  {header}
                </th>
              ))}
            </tr>
          </thead>

          <tbody class="divide-y divide-gray-200">
            {rows.map((row) => (
              <tr class="transition-colors hover:bg-gray-50">
                {headers.map((_, index) => (
                  <td
                    class="min-w-40 max-w-sm px-4 py-3 leading-6
                         text-gray-700 sm:px-5 sm:py-4
                         [overflow-wrap:anywhere]"
                  >
                    {row[index] ?? ""}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  ) : (
    <p class="my-4 rounded-lg bg-gray-50 p-4 text-sm text-gray-500">
      No table data available.
    </p>
  )
}
