---
import "../styles/global.css";
import MainHead from "./helper/MainHead.astro";
import Nav from "./helper/Nav.astro";
import Footer from "./helper/Footer.astro";
import ImageComp from "../components/helper/ImageComp.astro";

const { title, description, pubDate, author, imageSrc, imageAlt } = Astro.props;
---

<MainHead title={title}>
  <div
    class="flex flex-col min-h-screen justify-start items-center w-full bg-neutral-100 dark:bg-neutral-950"
  >
    <Nav />
    <article
      class="flex flex-col items-center justify-start max-w-[1220px] gap-2 px-2 py-4 w-full"
    >
      <h1>{title}</h1>
      <ImageComp
        imgSrc={imageSrc}
        altTxt={imageAlt}
        class="w-full max-w-[800px] rounded-lg shadow-md"
      />
      <!-- <img
        src={imageSrc.src}
        alt={imageAlt}
        class="w-full max-w-[800px] rounded-lg shadow-md"
      /> -->
      <p class="text-lg text-muted-foreground">{description}</p>
      <p class="text-sm text-muted-foreground">
        By {author} on {pubDate.toLocaleDateString()}
      </p>
      <slot />
    </article>
    <Footer />
  </div>
</MainHead>
