---
import HeadWrap from "./Head/HeadWrap.astro";

interface Props {
  id?: string;
  title: string;
  description?: string;

  // SEO
  canonicalURL?: URL;
  noindex?: boolean;

  // Open Graph / Social
  ogType?: "website" | "article";
  ogImage?: string;
  ogImageAlt?: string;

  // Article
  publishedTime?: string | Date;
  modifiedTime?: string | Date;
  author?: string;
  category?: string;
  tags?: string[];

  // Site
  siteName?: string;
  siteUrl?: string | URL;

  // JSON-LD
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];

  // Optional
  favicon?: string;
}

const {
  id,
  title,
  description = "Read the latest technology news, reviews, guides, and insights.",
  canonicalURL,
  noindex = false,
  ogType = "website",
  ogImage,
  ogImageAlt,
  publishedTime,
  modifiedTime,
  author,
  category,
  tags = [],
  siteName = "LEO Reviews",
  siteUrl = "https://leoreviews.com",
  jsonLd,
  favicon = "/favicon.png",
} = Astro.props;
---

<head>
  <HeadWrap
    id={id}
    title={title}
    description={description}
    canonicalURL={canonicalURL}
    noindex={noindex}
    ogType={ogType}
    ogImage={ogImage}
    ogImageAlt={ogImageAlt}
    publishedTime={publishedTime}
    modifiedTime={modifiedTime}
    author={author}
    category={category}
    tags={tags}
    siteName={siteName}
    siteUrl={siteUrl}
    jsonLd={jsonLd}
    favicon={favicon}
  />
</head>
<body>
  <slot />
</body>
